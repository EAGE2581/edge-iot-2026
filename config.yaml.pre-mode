mqtt:
  host: "localhost"
  port: 8883
  tls:
    enabled: true
    ca: "/home/hldqa/opcua-lab/certs/ca.crt"
    cert: "/home/hldqa/opcua-lab/certs/client.crt"
    key: "/home/hldqa/opcua-lab/certs/client.key"






influx:
  url: "http://localhost:8086"
  token: "edge-lab-admin-token-2026-secret"
  org: "edge-lab"
  bucket: "industrial_data"

profiles:
  sj:
    mode: "udt_array"
    interval: 5
    rated_current: 16.0
    udt_start_base: 16
    udt_start_step: 12
    fields:
      - {name: "zsw1",        offset: 2,  type: "raw"}
      - {name: "nist_a",      offset: 4,  type: "speed"}
      - {name: "iatst_glatt", offset: 5,  type: "current"}
      - {name: "mist_glatt",  offset: 6,  type: "raw"}
      - {name: "warn_code",   offset: 7,  type: "raw"}
      - {name: "fault_code",  offset: 8,  type: "raw"}
      - {name: "motor_temp",  offset: 9,  type: "temp"}
      - {name: "udc",         offset: 10, type: "raw"}
      - {name: "u_out",       offset: 11, type: "raw"}

  lh:
    mode: "udt_array"
    interval: 5
    rated_current: 16.0
    udt_start_base: 16
    udt_start_step: 9
    fields:
      - {name: "zsw1",        offset: 2,  type: "raw"}
      - {name: "nist_a",      offset: 4,  type: "speed"}
      - {name: "iatst_glatt", offset: 5,  type: "current"}
      - {name: "mist_glatt",  offset: 6,  type: "raw"}
      - {name: "warn_code",   offset: 7,  type: "raw"}
      - {name: "fault_code",  offset: 8,  type: "raw"}

plcs:
  - {name: "sj_line1_plc1",  profile: "sj", url: "opc.tcp://192.168.21.1:4840",  topic: "factory/sj/line1/plc1/data",  drive_count: 4}
