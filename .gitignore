offline_cache.db
*.db-journal
*.sqlite
*.sqlite3

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ── 虚拟环境 ──
venv/
.venv/
env/

# ── 编辑器 / IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── 系统 ──
.DS_Store
Thumbs.db

# ── 历史归档（本地保留，不提交）──
legacy/

# ── 日志 ──
*.log
logs/

# 证书私钥（绝对不提交）
certs/
*.key
*.crt
*.pem
